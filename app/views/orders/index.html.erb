<div class="container mt-4">
  <% if @user.orders.any? %>
    <% if @approved_orders.present? %>
      <h3 class="text-primary">Orders awaiting your confirmation:</h3>
      <% @approved_orders.each do |order| %>
        <div class="card mb-3" onclick="location.href='<%= order_path(order) %>'" style="cursor: pointer;">
          <div class="card-body">
            <h4 class="text-warning">Expires on: <%= order.order_price.expiration_date %></h4>
            <h5>Buffet: <%= order.buffet.name %></h5>
            <h6><%= order.event_type.name %></h6>
            <span><%= order.date %></span>
            <%= link_to order.code, order, class: 'stretched-link' %>
          </div>
        </div>
      <% end %>
    <% end %>

    <% if @pending_orders.present? %>
      <h3 class="text-warning">Orders awaiting Buffet's approval:</h3>
      <% @pending_orders.each do |order| %>
        <div class="card mb-3" onclick="location.href='<%= order_path(order) %>'" style="cursor: pointer;">
          <div class="card-body">
            <h5>Buffet: <%= order.buffet.name %></h5>
            <h6><%= order.event_type.name %></h6>
            <span><%= order.date %></span>
            <%= link_to order.code, order, class: 'stretched-link' %>
          </div>
        </div>
      <% end %>
    <% end %>

    <% if @confirmed_orders.present? %>
      <h3 class="text-success">Confirmed orders:</h3>
      <% @confirmed_orders.each do |order| %>
        <div class="card mb-3" onclick="location.href='<%= order_path(order) %>'" style="cursor: pointer;">
          <div class="card-body">
            <h5>Buffet: <%= order.buffet.name %></h5>
            <h6><%= order.event_type.name %></h6>
            <span><%= order.date %></span>
            <%= link_to order.code, order, class: 'stretched-link' %>
          </div>
        </div>
      <% end %>
    <% end %>

    <% if @cancelled_orders.present? %>
      <h3 class="text-danger">Cancelled orders:</h3>
      <% @cancelled_orders.each do |order| %>
        <div class="card mb-3" onclick="location.href='<%= order_path(order) %>'" style="cursor: pointer;">
          <div class="card-body">
            <h5>Buffet: <%= order.buffet.name %></h5>
            <h6><%= order.event_type.name %></h6>
            <span><%= order.date %></span>
            <%= link_to order.code, order, class: 'stretched-link' %>
            <% if order.fine_charge && order.fine_charge.pending? %>
              <strong class="text-danger">Pending Fine</strong>
            <% elsif order.fine_charge && order.fine_charge.paid? %>
              <strong class="text-success">Fine Paid</strong>            
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  <% else %>
    <h3>No orders registered.</h3>
  <% end %>
</div>
